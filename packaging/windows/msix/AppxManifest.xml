<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for the Microsoft Store. CI fills in the __PLACEHOLDERS__ (see .github/workflows/build.yml):
  the identity name, publisher and publisher display name come from Partner Center (Product identity page) through the
  repository variables MSIX_IDENTITY_NAME, MSIX_PUBLISHER and MSIX_PUBLISHER_DISPLAY_NAME; the version is the one in
  wails.json with a fourth part of 0, as the Store wants it.
  The app runs as a full-trust desktop app, so scanning any folder or disk and moving files to the Recycle Bin work as
  they do in the installer build.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>mormiDiskFree</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Disk space and disk usage analyzer: see what takes the space, as a sunburst chart or a treemap, and move what you pick to the Recycle Bin.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="mormiDiskFree" Executable="mormidiskfree.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="mormiDiskFree"
        Description="Disk space and disk usage analyzer"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile />
      </uap:VisualElements>
      <Extensions>
        <!-- Typing `mormidiskfree` in a terminal or the Run box starts the app. -->
        <uap3:Extension Category="windows.appExecutionAlias" EntryPoint="Windows.FullTrustApplication" Executable="mormidiskfree.exe">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="mormidiskfree.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
